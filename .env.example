# Identifiants du portail développeur Supercell (https://developer.clashofclans.com).
# Servent à générer/rafraîchir automatiquement le token API Clash of Clans.
# Copiez ce fichier en « .env » et renseignez vos valeurs (ne jamais committer .env).
#
# Astuce : si le .env est absent au premier appel API, une fenêtre de saisie
# s'ouvre automatiquement pour le créer.

DEV_EMAIL=votre.email@example.com
DEV_PASSWORD=votre_mot_de_passe

# (Optionnel) Dossier de données personnalisé (macros, configs, exports).
# Par défaut : la racine du projet. Décommentez pour rediriger ailleurs.
# COC_BOT_DATA_DIR=C:\chemin\vers\mes\donnees

# --- Synchronisation du classeur de surveillance entre plusieurs postes ---
# Optionnel. Permet de surveiller depuis plusieurs ordinateurs sans perdre de
# données : le classeur du salon Discord est fusionné avant chaque surveillance
# et republié après. Voir src/coc_bot/core/discord_sync.py pour la mise en place
# (une application Discord avec un bot, invitée sur le serveur).
#
# Le TOKEN est un secret : il ne doit jamais être committé ni partagé.
# DISCORD_BOT_TOKEN=le_token_de_votre_bot
#
# L'identifiant du salon n'est pas secret ; il peut aussi être saisi directement
# dans l'écran Surveillance de l'application.
# DISCORD_SYNC_CHANNEL_ID=123456789012345678
